{
    "name": "atwx/silverstripe-htmlfield-cleaner",
    "description": "Cleans HTML fields (tags, attributes, inline styles) of DataObjects before writing, configurable via YAML",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "CMS",
        "html",
        "cleaner",
        "tinymce"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "silverstripe/framework": "^6",
        "mehr-it/html-cleaner": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3",
        "silverstripe/standards": "^1",
        "phpstan/extension-installer": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Atwx\\HtmlFieldCleaner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atwx\\HtmlFieldCleaner\\Tests\\": "tests/php/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
